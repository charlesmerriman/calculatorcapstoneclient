VITE_API_URL=http://localhost:8000

# Closed-beta passcode gate (see src/services/betaAccess.ts).
#
# INTENTIONALLY BLANK, and it must stay that way. Vite loads this file for
# production builds too, so any hash committed here becomes the fallback if the
# DigitalOcean variable is ever missing or misspelled — and a fallback whose
# passcode is published in a public repo is worse than no gate at all, because
# the site would look protected while accepting a known code. Blank means a
# misconfiguration fails open and visibly, which is the documented behaviour.
#
# Production value lives ONLY on the DigitalOcean frontend component (BUILD_TIME).
# To exercise the gate locally, put a hash in .env.local (gitignored via *.local):
#   npm run hash-passcode -- 'YourPasscode'
VITE_BETA_PASSCODE_HASH=
