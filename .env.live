# Vite mode file for `npm run dev:live` (i.e. `vite --mode live`).
#
# Runs the local dev server — your local source, HMR, React DevTools — against
# the LIVE production API instead of your local Django backend. Nothing here is
# a secret; it is the same public URL the deployed site uses.
#
# Loaded ONLY when --mode live is passed. Vite applies env files in increasing
# order of priority (.env -> .env.local -> .env.[mode] -> .env.[mode].local), so
# this overrides VITE_API_URL from .env while leaving everything else — notably
# VITE_BETA_PASSCODE_HASH in .env.local — exactly as it was.
#
# The /api prefix is required. App Platform's ingress routes /api to the Django
# component and strips the prefix before forwarding, so /api/calculator-data
# reaches Django as /calculator-data. Without the prefix the request falls
# through to the frontend component and returns the SPA's index.html with a 200,
# which fails as a confusing JSON parse error rather than a clean 404.
VITE_API_URL=https://umamusme-calculator-7zdcg.ondigitalocean.app/api

# What works in this mode, and what does not:
#
#   Works — every page in guest mode. All content (banners, events, ranks,
#   calculation constants, the income ledger) is public and read-only.
#
#   Does NOT work — signing in. The backend derives OAUTH_REDIRECT_URI from its
#   own FRONTEND_URL, so a provider round-trip lands on the deployed site rather
#   than localhost. Saving a plan needs auth, so it is unavailable here too.
#   That is the safety property, not a limitation to work around: this mode
#   cannot write to production.
#
# Do not use this file for `vite build`. It is a dev-server mode; a build run
# with --mode live would ship a bundle with import.meta.env.DEV still true.
# Production builds get VITE_API_URL from the DigitalOcean component config.
