# The /api prefix is required — App Platform's ingress routes /api to the Django
# component and strips it, so /api/calculator-data arrives as /calculator-data.
# Without it the request is served by the frontend component as index.html with a
# 200, which surfaces as a JSON parse error rather than a clean 404.
#
# In the real deploy this value is overridden by the BUILD_TIME VITE_API_URL on
# the DigitalOcean component (see backend/.do/app.yaml), which is why the missing
# prefix here was inert. It still matters as the fallback if that var is ever
# dropped, and it is what `npm run preview` uses locally.
VITE_API_URL=https://umamusme-calculator-7zdcg.ondigitalocean.app/api